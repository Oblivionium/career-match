# Copy to .env and fill in. Never commit .env.

# --- Agent seeds: long random secret phrases, one per agent. They fix each agent's address.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
COORD_SEED=
RESUME_SEED=
SCOUT_SEED=
MATCH_SEED=

# true when connecting to Agentverse/ASI:One; run_local.py forces false.
USE_MAILBOX=true

# Ports (each agent needs its own when run separately)
COORD_PORT=8001
RESUME_PORT=8002
SCOUT_PORT=8003
MATCH_PORT=8004

# --- ASI:One LLM (https://asi1.ai -> developer / API keys). Without it, agents use rule-based fallbacks.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1

# --- Job sources. Remotive and Arbeitnow need no key. Add at least one keyed source for India coverage.
# Adzuna: https://developer.adzuna.com (free)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# JSearch on RapidAPI (free tier): https://rapidapi.com  -> search "JSearch"
JSEARCH_API_KEY=
JOB_CACHE_TTL_SECONDS=1800
# For the demo video: force sources to fail to show fallback, e.g. SIMULATE_SOURCE_FAILURE=adzuna
SIMULATE_SOURCE_FAILURE=

# --- Payments (Agent Payment Protocol, FET)
PAYMENTS_ENABLED=true
PACK_PRICE_FET=0.5
FET_USE_TESTNET=true
# Wallet that receives payments. Empty = the coordinator agent's own wallet (printed on startup).
PAYMENT_WALLET=

# Seconds to wait for a worker agent before falling back to local logic
WORKER_TIMEOUT=60
